# Copy to .env and fill in locally. Never commit .env.
# Claude API key from the class Claude Console organization (needed from Milestone 3).
ANTHROPIC_API_KEY=
# Workspace ID from the Claude Console (needed when the key is not scoped to a workspace).
ANTHROPIC_WORKSPACE_ID=
# Optional overrides of config.toml
# STAYWATCH_INBOX=inbox
# STAYWATCH_GENERATOR_INTERVAL_SECONDS=60
# TypeSafe Jev API key (early access), used for classification from Milestone 3.
JEV_API_KEY=
